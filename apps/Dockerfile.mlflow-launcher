FROM python:3.13-slim-bookworm@sha256:281d39ff02e3b389401586134ff9e6572954687822a58055ec07a60ded4e0b7f
WORKDIR /app
COPY apps/launcher-requirements.lock /app/requirements.lock
RUN pip install --no-cache-dir --require-hashes -r requirements.lock
COPY apps/mlflow_launcher.py apps/alb_auth.py /app/apps/
USER 10001:10001
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "apps.mlflow_launcher:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
