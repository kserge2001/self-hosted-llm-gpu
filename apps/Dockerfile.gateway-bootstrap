FROM python:3.13-slim-bookworm@sha256:281d39ff02e3b389401586134ff9e6572954687822a58055ec07a60ded4e0b7f
WORKDIR /app
COPY apps/bootstrap-requirements.lock /app/requirements.lock
RUN pip install --no-cache-dir --require-hashes -r /app/requirements.lock
COPY apps/initialize_gateway.py /app/initialize_gateway.py
COPY k8s/gateway/files/rds-ca.pem /app/rds-ca.pem
USER 10001:10001
ENTRYPOINT ["python", "/app/initialize_gateway.py"]
